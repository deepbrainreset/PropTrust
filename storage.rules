rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    match /properties/{userId}/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 12 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /verifications/{userId}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
